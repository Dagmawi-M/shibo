{
  "name": "shibo",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test \"engine/test/*.test.ts\"",
    "build": "node scripts/build.mjs",
    "app": "node scripts/build.mjs && node server/standalone.ts",
    "pretest": "node scripts/build.mjs",
    "package": "node scripts/build.mjs && cd extension && npx --yes @vscode/vsce package --allow-missing-repository --no-dependencies",
    "test:browser": "node scripts/build.mjs && node --test --test-concurrency=1 \"tests/browser/*.test.ts\""
  },
  "dependencies": {
    "@wokwi/elements": "^1.9.2",
    "avr8js": "^0.21.1",
    "esbuild": "^0.28.2",
    "rp2040js": "^1.4.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Dagmawi-M/shibo.git"
  },
  "homepage": "https://github.com/Dagmawi-M/shibo#readme",
  "bugs": {
    "url": "https://github.com/Dagmawi-M/shibo/issues"
  },
  "license": "MIT",
  "description": "Offline circuit simulator for Arduino sketches, as a VS Code extension and a local web app."
}
